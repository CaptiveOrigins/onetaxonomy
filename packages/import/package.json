{
  "name": "@extantape/onetaxonomy-import",
  "version": "0.1.0-alpha.4",
  "description": "OneTaxonomy import: source adapters for CSV/TSV checklists, Darwin Core Archives, OneTaxonomy JSON, Newick, NEXUS and phyloXML, plus reconciliation, curated selective imports with provenance, and community presets.",
  "keywords": [
    "taxonomy",
    "phylogeny",
    "newick",
    "nexus",
    "phyloxml",
    "darwin-core",
    "dwca",
    "checklist",
    "import",
    "biodiversity"
  ],
  "homepage": "https://github.com/ExtantApe/OneTaxonomy#readme",
  "bugs": {
    "url": "https://github.com/ExtantApe/OneTaxonomy/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtantApe/OneTaxonomy.git",
    "directory": "packages/import"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@extantape/onetaxonomy-core": "workspace:^"
  }
}

{
  "name": "@captiveorigins/payload-plugin-onetaxonomy",
  "version": "0.1.0-alpha.3",
  "description": "OneTaxonomy for Payload: sealed taxonomy snapshots verified by checksum, published views pinned to them, resumable import jobs that turn checklists, Darwin Core Archives and tree files into staged snapshots, and a bounded, permission-checked API for search, ancestors, descendants, MRCA, coverage, projected views and exports, with optional tenant scope.",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "taxonomy",
    "phylogeny",
    "classification",
    "mrca",
    "biodiversity",
    "darwin-core",
    "newick"
  ],
  "homepage": "https://github.com/CaptiveOrigins/onetaxonomy#readme",
  "bugs": {
    "url": "https://github.com/CaptiveOrigins/onetaxonomy/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptiveOrigins/onetaxonomy.git",
    "directory": "packages/payload"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/client/panels.css dist/client/panels.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@captiveorigins/onetaxonomy-core": "workspace:^",
    "@captiveorigins/onetaxonomy-import": "workspace:^",
    "@captiveorigins/onetaxonomy-react": "workspace:^"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.80.0",
    "payload": "^3.80.0",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@payloadcms/ui": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.93.0",
    "@payloadcms/graphql": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "graphql": "^16.15.0",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "payload": "^3.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}

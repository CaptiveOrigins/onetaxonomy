{
  "name": "@extantape/onetaxonomy-layout",
  "version": "0.1.0-alpha.4",
  "description": "OneTaxonomy layout: deterministic tree layouts (rectangular cladogram, phylogram and time scale only when the data supports them, radial, classification sunburst) as plain coordinates for any renderer.",
  "keywords": [
    "taxonomy",
    "phylogeny",
    "tree-layout",
    "cladogram",
    "phylogram",
    "sunburst",
    "visualization"
  ],
  "homepage": "https://github.com/ExtantApe/OneTaxonomy#readme",
  "bugs": {
    "url": "https://github.com/ExtantApe/OneTaxonomy/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtantApe/OneTaxonomy.git",
    "directory": "packages/layout"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@extantape/onetaxonomy-core": "workspace:^"
  }
}

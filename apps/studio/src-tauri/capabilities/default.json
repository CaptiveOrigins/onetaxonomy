{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the OneTaxonomy window may do",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    { "identifier": "fs:scope", "allow": [{ "path": "$HOME/**" }, { "path": "/Volumes/**" }] },
    "store:default",
    "process:allow-restart",
    "updater:default"
  ]
}

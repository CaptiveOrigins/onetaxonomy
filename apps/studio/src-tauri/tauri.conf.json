{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneTaxonomy",
  "version": "0.2.0",
  "identifier": "com.extantape.onetaxonomy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OneTaxonomy",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "nwk",
          "newick",
          "treefile"
        ],
        "name": "Newick tree",
        "role": "Viewer"
      },
      {
        "ext": [
          "json"
        ],
        "name": "OneTaxonomy snapshot",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ExtantApe/OneTaxonomy/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1RDA3Q0JFMDdENDU1QTEKUldTaFZkUUh2bnpRRlY5YVpwVnFLNGJvdUdrNHNxelZtcG1CMTI0ZXB4RDkvQzB2Tzc0WVlsbGwK"
    }
  }
}

{
  "name": "onetaxonomy-studio",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "OneTaxonomy for Mac: open checklists, Darwin Core Archives, trees and snapshots, then browse and save views.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
